# Copy to .env and fill in. Real environment variables win over this file.
# .env is gitignored.

# Which adapter to use: ollama | groq | openai
RA_PROVIDER=groq

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides
# RA_MODEL=openai/gpt-oss-120b
# RA_JUDGE_MODEL=openai/gpt-oss-20b
# RA_TEMPERATURE=0.2
# RA_MAX_TOKENS=
# RA_CACHE_TTL=86400
# RA_TIMEOUT=20

# Cost accounting: USD per 1M tokens. Leave unset to use research_agent/pricing.py.
# Set both or neither; an unknown model is reported as unpriced, never as $0.
# RA_PRICE_INPUT=
# RA_PRICE_OUTPUT=
